process {
    executor = 'slurm'
    // Default to the CPU partition so any unlisted process never lands on GPU.
    queue = params.slurm_cpu_partition
    clusterOptions = "--partition=${params.slurm_cpu_partition}"

    // CPU processes — includes the HemaScribe canonical-annotation chain
    // (EXPORT_FOR_HEMASCRIBE → … → CLEAN_COLUMNS) and the downstream
    // composition / DEG / pathway analyses.
    withName: 'QC|DOUBLETS|NORMALIZE|CLUSTER|RECONCILE_ANNOTATIONS|MARKERS|MANUAL_MARKER_REVIEW|APPLY_MANUAL_ANNOTATION|FREEZE_MANUAL_ANNOTATION|SUBSET_RECLUSTER|FINAL_FIGURES|PROGENITOR_RECLUSTER|APPLY_PROGENITOR_ANNOTATION|EXPORT_FOR_HEMASCRIBE|HEMASCRIBE|MERGE_HEMASCRIBE|FINALIZE_ANNOTATION|CLEAN_COLUMNS|MACROPHAGE_STATES|COMPOSITION_SCCODA|PSEUDOBULK_DEG|PATHWAY_ACTIVITY' {
        queue = params.slurm_cpu_partition
        clusterOptions = "--partition=${params.slurm_cpu_partition} --time=04:00:00"
    }

    // scVI integration — light GPU job; moderate walltime so it schedules fast.
    withName: 'INTEGRATE' {
        queue = params.slurm_gpu_partition
        clusterOptions = "--partition=${params.slurm_gpu_partition} --gres=gpu:1 --time=${params.gpu_time}"
    }

    // popV reference annotation — heavier (retrain); keep a longer walltime.
    // Off by default (run_label_transfer=false).
    withName: 'ANNOTATE_HSPC|ANNOTATE_MATURE' {
        queue = params.slurm_gpu_partition
        clusterOptions = "--partition=${params.slurm_gpu_partition} --gres=gpu:1 --time=04:00:00"
    }
}
