// Local executor — run on a single workstation (no SLURM, no container; uses the
// host pixi environment). Process cpu/memory requests are capped to the host's
// actual resources via `resourceLimits`, so a request larger than the machine is
// scaled down instead of triggering a "requirement exceeds available" error.

def _cpus = Runtime.runtime.availableProcessors()
def _memGb = 16   // fallback (e.g. macOS, where /proc/meminfo is absent)
try {
    def line = new File('/proc/meminfo').readLines().find { it.startsWith('MemTotal') }
    if (line) {
        long kb = line.replaceAll(/\D/, '') as long
        _memGb = Math.max(1, (long) (kb / 1024 / 1024 * 0.9))   // kB -> GB, 10% headroom
    }
} catch (ignored) { }

process {
    executor = 'local'
    resourceLimits = [ cpus: _cpus, memory: "${_memGb} GB" ]
}

executor {
    cpus = _cpus
    memory = "${_memGb} GB"
}
