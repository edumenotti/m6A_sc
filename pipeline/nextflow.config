params {
    h5_input = "${projectDir}/../data/count/filtered_feature_bc_matrix.h5"
    hspc_ref_h5ad = "${projectDir}/../data/references/nestorowa_2016_hspc.h5ad"
    hspc_ref_labels_key = "cell_type"
    hspc_ref_batch_key = "reference_batch"
    mature_ref_h5ad = "${projectDir}/../data/references/kucinski_2024_bone_marrow.h5ad"
    mature_ref_labels_key = "cell_type"
    mature_ref_batch_key = "reference_batch"
    outdir = "${projectDir}/../results"
    mito_nmads = 4.0
    count_nmads = 6.0
    expected_doublet_rate = 0.075
    doubletfinder_pcs = 20
    doubletfinder_pk = 0.09
    doubletfinder_auto_pk = false
    doubletfinder_install_missing = true
    n_hvgs = 3000
    n_latent = 30
    max_epochs = 400
    leiden_resolution = 0.5
    // Canonical manual annotation backbone: leiden_r1.0 + the coarse→fine full map
    // (manual_level1 + manual_level2). Downstream subset-recluster (script 12) is
    // hardcoded to leiden_r1.0 clusters 15/13, so this must stay r1.0.
    leiden_resolution_manual = 1.0
    annotation_version = "manual_full_r1.0_2026-05-05"
    manual_annotation_map = "${projectDir}/config/manual_annotation_full_map_leiden_r1.0.tsv"
    popv_methods = "KNN_BBKNN,KNN_SCVI,SCANVI_POPV,Support_Vector,XGboost"
    popv_mode = "retrain"
    popv_hvg = 4000
    popv_samples_per_label = 300
    reconcile_hspc_label_regex = '(?i)(^|[^A-Za-z])(LT-?HSC|ST-?HSC|HSC|MPP|LMPP|CMP|GMP|MEP|HSPC|progenitor|prog|stem)([^A-Za-z]|$)'
    reconcile_min_confidence = 0.55
    reconcile_cluster_majority_min_fraction = 0.70
    progenitor_annotation_map = "${projectDir}/config/progenitor_annotation_map.tsv"
    run_progenitor_recluster = true
    // Manual annotation strategy. Default: transfer the frozen canonical per-cell
    // labels by barcode (reproducible on any hardware). Set true to re-derive from
    // clustering via the cluster-ID maps (only reproducible on the original machine).
    // The frozen file carries manual_level1/level2/confidence + the in-silico
    // genotype (WT/Mutant) — both per-cell labels the pipeline cannot re-derive.
    rederive_manual_annotation = false
    frozen_per_cell_labels = "${projectDir}/config/canonical_per_cell_labels.csv.gz"
    // Reference-based automatic annotation (popV against Nestorowa + Kucinski).
    // Provides 'final_cell_type' / 'popv_prediction' / 'scanvi_label' as context
    // for manual review (script 09). The final manual_level1/level2 calls override
    // these, so the step is informational; default off to save GPU time.
    run_label_transfer = false
    // Downstream analysis (scripts 15, 18, 19, 20): macrophage states, scCODA composition,
    // pseudobulk DEG, pathway activity. Replaces the deprecated run_interaction_analysis flag
    // (CellChat/NicheNet were archived 2026-05-12 due to composition confound + n=2).
    run_downstream_analysis = false
    pseudobulk_min_cells    = 10
    pathway_organism        = 'mouse'
    // Cell-type level(s) fed to composition/DEG (comma-separated). The canonical
    // annotation is `cell_type` (HemaScribe + manual validation, scripts 21*/22).
    downstream_levels       = 'cell_type'
    cellchat_organism       = 'Mm'  // kept for backward compat if 16/17 are re-run manually
    pixi_manifest = "${projectDir}/../pixi.toml"
    container_image = "${projectDir}/../charles-scrna.sif"
    // GPU job sizing for the scVI INTEGRATE step. Kept moderate so the request
    // schedules quickly on a shared GPU partition: scVI on ~42k cells × 3k HVGs
    // is light (minutes on a GPU, fits in <16 GB). Bump per cluster if needed.
    gpu_mem  = '16 GB'
    gpu_cpus = 4
    gpu_time = '02:00:00'
    // Slurm partitions (override per cluster; defaults match Grace/McCleary).
    // Bouchet etc.: pass e.g. --slurm_cpu_partition day --slurm_gpu_partition gpu
    slurm_cpu_partition = 'general'
    slurm_gpu_partition = 'gpu'
}

profiles {
    // Default when no -profile is given: run locally on the host pixi env.
    standard {
        includeConfig 'conf/local.config'
    }
    local {
        includeConfig 'conf/local.config'
    }
    slurm {
        includeConfig 'conf/slurm.config'
    }
    apptainer {
        includeConfig 'conf/apptainer.config'
    }
    // Yale Bouchet — self-contained profile: set the partition params FIRST, then
    // include slurm + apptainer so the configs interpolate the right partitions
    // (profile-ordering would otherwise freeze the defaults). Use alone:
    //   -profile bouchet
    bouchet {
        params.slurm_cpu_partition = 'day'
        params.slurm_gpu_partition = 'gpu'
        includeConfig 'conf/slurm.config'
        includeConfig 'conf/apptainer.config'
    }
}

process.shell = ['/bin/bash', '-euo', 'pipefail']

// Redirect library caches to writable dirs. Inside the Apptainer image the pixi
// site-packages and $HOME are read-only, so numba's JIT cache (@njit(cache=True))
// and matplotlib's config dir must point at /tmp or tasks fail with
// "no locator available". Harmless locally.
env {
    NUMBA_CACHE_DIR = '/tmp/numba_cache'
    MPLCONFIGDIR    = '/tmp/mpl_cache'
}
