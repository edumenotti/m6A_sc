Bootstrap: docker
From: ubuntu:22.04

%labels
    Maintainer Eduardo Menotti
    Project charles-scrna
    Description scRNA-seq pipeline environment (pixi-locked + HemaScribe)

%files
    pixi.toml /project/pixi.toml
    pixi.lock /project/pixi.lock

%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get update && apt-get install -y \
        curl \
        ca-certificates \
        build-essential \
        libssl-dev \
        libffi-dev \
        git \
        gfortran \
        libblas-dev \
        liblapack-dev \
        libopenblas-dev \
        && apt-get clean && rm -rf /var/lib/apt/lists/*

    # Install pixi to /opt/pixi
    export PIXI_HOME=/opt/pixi
    curl -fsSL https://pixi.sh/install.sh | bash
    export PATH="/opt/pixi/bin:$PATH"

    # Install BOTH locked environments into the container:
    #   default — main pipeline (scanpy, Seurat, scCODA, PyDESeq2, decoupler, HemaScribe deps)
    #   popv    — optional reference-based annotation env (run_label_transfer=true)
    pixi install --locked --manifest-path /project/pixi.toml -e default
    # popv env: pixi+uv fails to resolve PyPI packages inside fakeroot containers.
    # Workaround: install conda part (ignore PyPI error), then install the 3
    # known PyPI-only deps directly via the conda-installed python.
    pixi install --locked --manifest-path /project/pixi.toml -e popv 2>/dev/null || true
    POPV_PY=$(find /project/.pixi/envs/popv/bin -name "python3*" -type f | sort | head -1)
    if [ -n "$POPV_PY" ]; then
        $POPV_PY -m pip install "popv>=0.3" "obonet>=1.0" "gdown>=4.6" --quiet
    else
        echo "WARNING: popv python not found, skipping PyPI install"
    fi

    # Install HemaScribe (R package from GitHub, not on conda-forge/bioconda).
    # Deps (RhpcBLASctl, harmony, symphony) compile using conda's own toolchain.
    # DO NOT set custom Makevars: conda R already has correct BLAS config in
    # its Makeconf. Overriding it breaks the linker. Just expose PATH/LD_LIBRARY_PATH
    # and set R_LIBS so pixi-installed packages (org.Mm.eg.db) are visible.
    PIXI_ENV=/project/.pixi/envs/default
    export PATH="$PIXI_ENV/bin:$PATH"
    export LD_LIBRARY_PATH="$PIXI_ENV/lib:${LD_LIBRARY_PATH:-}"
    export R_LIBS="$PIXI_ENV/lib/R/library"

    # piggyback is installed by conda (via r-devtools) but the .rdb ends up as a
    # directory instead of a file, breaking R's lazy loading. Remove it so R can
    # reinstall it cleanly via CRAN.
    RLIB=/project/.pixi/envs/default/lib/R/library
    rm -rf "$RLIB"/00LOCK-*
    if [ -d "$RLIB/piggyback" ]; then
        rm -rf "$RLIB/piggyback"
    fi

    echo "=== Installing HemaScribe from GitHub ===" && \
    /project/.pixi/envs/default/bin/Rscript -e "
      options(repos = c(CRAN='https://cloud.r-project.org'))
      # Explicitly set lib path — more reliable than R_LIBS in conda context
      .libPaths('/project/.pixi/envs/default/lib/R/library')
      if (!requireNamespace('remotes', quietly=TRUE)) install.packages('remotes')
      # Ensure org.Mm.eg.db is present (should come from pixi, fallback to Bioconductor)
      if (!requireNamespace('org.Mm.eg.db', quietly=TRUE)) {
        message('org.Mm.eg.db not in .libPaths — installing via BiocManager')
        if (!requireNamespace('BiocManager', quietly=TRUE)) install.packages('BiocManager')
        BiocManager::install('org.Mm.eg.db', update=FALSE, ask=FALSE)
      }
      # Install compilation-heavy deps explicitly first (verbose to catch errors)
      # Ncpus=1: compile serially. symphony pulls RcppArmadillo, whose C++ compile
      # is memory-heavy; parallel installs spike peak RAM and get OOM-killed on
      # smaller build nodes ("symphony had non-zero exit status" with no clear error).
      install.packages(c('RhpcBLASctl', 'harmony', 'symphony'), Ncpus=1L)
      # Pinned to a fixed commit for reproducible builds (was unpinned HEAD).
      # --no-docs/--no-help/--no-html: skip help-index generation, which fails on
      # the cluster build filesystem ('help/AnIndex: it is a directory'); the
      # in-container package does not need its man pages.
      remotes::install_github('RabadanLab/HemaScribe@d50c844564f8505469b2efab602cce76e78b06a5',
                              upgrade='never', quiet=FALSE,
                              INSTALL_opts = c('--no-docs', '--no-help', '--no-html'))
      # Hard fail if package didn't actually install
      if (!requireNamespace('HemaScribe', quietly=TRUE)) {
        stop('HemaScribe installation failed — check warnings above')
      }
      cat('HemaScribe installed\n')
    "

    # DoubletFinder (GitHub, not on conda) — used by the doublets step (02). Baked
    # in so the runtime --install-missing is a no-op: the R lib is read-only at
    # runtime and HPC compute nodes are offline. Pinned + --no-help like HemaScribe;
    # deps (fields/maps/spam) come from CRAN.
    echo "=== Installing DoubletFinder from GitHub ===" && \
    /project/.pixi/envs/default/bin/Rscript -e "
      options(repos = c(CRAN='https://cloud.r-project.org'))
      .libPaths('/project/.pixi/envs/default/lib/R/library')
      if (!requireNamespace('remotes', quietly=TRUE)) install.packages('remotes')
      remotes::install_github('chris-mcginnis-ucsf/DoubletFinder@1b244d8f0d54b4b1cb4365639931bbb16f01e1cd',
                              upgrade='never', quiet=FALSE,
                              INSTALL_opts = c('--no-docs', '--no-help', '--no-html'))
      if (!requireNamespace('DoubletFinder', quietly=TRUE)) {
        stop('DoubletFinder installation failed — check warnings above')
      }
      cat('DoubletFinder installed\n')
    "

    # Pre-cache the HemaScribe reference at build time so runtime needs no internet
    # (HPC compute nodes are typically offline). Script 21b also calls these inside
    # try(), so a populated cache is simply reused. XDG_CACHE_HOME is fixed to an
    # in-image path so build- and run-time agree regardless of Apptainer's home mount.
    export XDG_CACHE_HOME=/project/.cache
    mkdir -p "$XDG_CACHE_HOME"
    echo "=== Pre-caching HemaScribe reference ===" && \
    /project/.pixi/envs/default/bin/Rscript -e "
      .libPaths('/project/.pixi/envs/default/lib/R/library')
      library(HemaScribe)
      try(download_data())
      try(download_mapping_data())
      cat('HemaScribe reference pre-cache attempted\n')
    "

    # Smoke-test: each language stack must load
    /project/.pixi/envs/default/bin/python -c "import scanpy; print('scanpy', scanpy.__version__)"
    /project/.pixi/envs/default/bin/python -c "import sccoda, pydeseq2, decoupler; print('sccoda/pydeseq2/decoupler ok')"
    /project/.pixi/envs/default/bin/Rscript -e "library(Seurat); cat('Seurat OK\n')"
    /project/.pixi/envs/default/bin/Rscript -e "library(HemaScribe); cat('HemaScribe OK\n')"
    /project/.pixi/envs/default/bin/Rscript -e "library(DoubletFinder); cat('DoubletFinder OK\n')"
    /project/.pixi/envs/popv/bin/python -c "import popv; print('popv', popv.__version__)"

%environment
    export PIXI_HOME=/opt/pixi
    export PATH="/opt/pixi/bin:/project/.pixi/envs/default/bin:$PATH"
    export PIXI_PROJECT_DIR=/project
    export R_LIBS_USER=/project/.pixi/envs/default/lib/R/library
    export XDG_CACHE_HOME=/project/.cache
    # site-packages + $HOME are read-only at runtime; send writable caches to /tmp.
    export NUMBA_CACHE_DIR=/tmp/numba_cache
    export MPLCONFIGDIR=/tmp/mpl_cache

%runscript
    exec "$@"
